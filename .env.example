# Go Gateway Settings
GO_SERVER_PORT=8080
PYTHON_AI_URL=http://127.0.0.1:5000

# Python AI Settings
PYTHON_AI_HOST=127.0.0.1
PYTHON_AI_PORT=5000

# Optional: AI Provider Keys (for full generative AI synthesis)
# If left blank, the scraper bot will use high-quality rule-based extraction
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_MODEL=gemini-2.5-flash

# Search providers: comma-separated duckduckgo, searxng, brave.
# SearXNG is useful when you operate an instance that aggregates engines you are entitled to use.
SEARCH_PROVIDERS=duckduckgo
SEARXNG_URL=
BRAVE_SEARCH_API_KEY=
SEARCH_TIMEOUT_SEC=12
